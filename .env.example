# Copy to .env and fill in values before running docker compose up

# PostgreSQL
POSTGRES_PASSWORD=toor

# Keycloak admin
KEYCLOAK_ADMIN_PASSWORD=admin

# pgAdmin
PGADMIN_DEFAULT_PASSWORD=toor

# BFF service account (must match icm-bff client secret in realm-export.json)
KC_CLIENT_SECRET=icm-bff-secret
